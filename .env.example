# ───── قاعدة البيانات (PostgreSQL) ─────
# من Supabase: زر Connect → Session pooler (المنفذ 5432). ضع نفس الرابط في المتغيرين.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ───── تخزين وثائق الوسطاء (Supabase Storage) ─────
# من Supabase: Project Settings → API. المفتاح سري: لا تضعه في الكود ولا تشاركه.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="broker-documents"
# بدون إعدادات Supabase تُحفظ الوثائق على القرص هنا (للتشغيل المحلي فقط)
UPLOAD_DIR="./storage/uploads"

# ───── الجلسات وحساب المدير ─────
# 32 حرفًا عشوائيًا على الأقل (openssl rand -base64 48)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
ADMIN_PHONE="0500000000"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="إدارة إزدان"

# مشاريع تجريبية عند أول تهيئة (1 لتفعيلها، 0 لقاعدة فارغة)
SEED_DEMO="1"
